{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bsw-devspark.bswhive.com/schemas/okf-knowledge-document.schema.json",
  "title": "OKF Knowledge Document",
  "description": "Minimum frontmatter contract for DevSpark-generated OKF knowledge documents (spec 005-spec-okf-knowledge-docs).",
  "type": "object",
  "required": ["id", "type", "title", "status", "links", "generated"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier, unique within the feature's knowledge/ folder."
    },
    "type": {
      "type": "string",
      "enum": ["feature", "requirement", "task"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "done"]
    },
    "links": {
      "type": "object",
      "description": "Relationship map; required keys depend on type (see contracts/knowledge-document-schema.md)."
    },
    "generated": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "feature" } } },
      "then": {
        "properties": {
          "links": {
            "required": ["requirements"],
            "properties": { "requirements": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "requirement" } } },
      "then": {
        "properties": {
          "links": {
            "required": ["feature", "implemented_by"],
            "properties": {
              "feature": { "type": "string" },
              "implemented_by": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "task" } } },
      "then": {
        "properties": {
          "links": {
            "required": ["feature", "implements"],
            "properties": {
              "feature": { "type": "string" },
              "implements": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  ]
}

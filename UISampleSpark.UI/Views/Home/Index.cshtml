@{
    ViewBag.Title = "One problem. Nine ways to build it. | ASP.NET Core UI patterns";
    ViewBag.MetaDescription = "The same employee directory built nine ways — MVC, Razor Pages, jQuery, vanilla JavaScript, React, Vue, htmx and Blazor — inside one ASP.NET Core app. A Make Bold Spark open-source project.";
    ViewBag.MetaKeywords = "ASP.NET Core, UI patterns, MVC, Razor Pages, React, Vue, htmx, Blazor, SPA, REST API, Docker, Make Bold Spark";
    ViewData["FlushMain"] = true;

    var patterns = new[]
    {
        new { Num = "01", Kind = "server", KindLabel = "Server", Name = "Traditional MVC", Route = "/MvcEmployee",
              Text = "Separate views for create, edit, details and delete. Full page loads and server-side validation. Plain, predictable, search-friendly.",
              Tags = new[] { ("Server-rendered", ""), ("SEO-friendly", "tag-positive") } },
        new { Num = "02", Kind = "hybrid", KindLabel = "Hybrid", Name = "jQuery AJAX + MVC", Route = "/Employee",
              Text = "One index view with modal forms. Partial views come back over AJAX, so the page never reloads.",
              Tags = new[] { ("Partial views", ""), ("Modal forms", "tag-accent") } },
        new { Num = "03", Kind = "server", KindLabel = "Server", Name = "Razor Pages", Route = "/EmployeeRazor",
              Text = "Page-focused, with UI and handler logic side by side. Less ceremony than MVC for straightforward CRUD.",
              Tags = new[] { ("Page model", ""), ("SEO-friendly", "tag-positive") } },
        new { Num = "04", Kind = "client", KindLabel = "Client", Name = "jQuery SPA", Route = "/EmployeeSinglePage",
              Text = "DataTables and modals over the REST API. The single-page pattern many teams already run in production.",
              Tags = new[] { ("DataTables", ""), ("REST API", "tag-info") } },
        new { Num = "05", Kind = "client", KindLabel = "Client", Name = "Vanilla JavaScript", Route = "/EmployeeVanilla",
              Text = "No libraries at all. Fetch, the DOM and the dialog element — a useful baseline for every other pattern here.",
              Tags = new[] { ("Zero dependencies", ""), ("Fetch API", "tag-info") } },
        new { Num = "06", Kind = "client", KindLabel = "Client", Name = "React", Route = "/EmployeeReact",
              Text = "Components and hooks against the same API. Familiar to most front-end hires, with the most to configure.",
              Tags = new[] { ("Components", ""), ("Most requested", "tag-brand") } },
        new { Num = "07", Kind = "client", KindLabel = "Client", Name = "Vue", Route = "/EmployeeVue",
              Text = "Reactive data with the Composition API. A gentler on-ramp than React for teams coming from server views.",
              Tags = new[] { ("Composition API", ""), ("REST API", "tag-info") } },
        new { Num = "08", Kind = "hybrid", KindLabel = "Hybrid", Name = "htmx", Route = "/EmployeeHtmx",
              Text = "HTML over the wire. The server stays in charge, and a few attributes give you SPA-like updates.",
              Tags = new[] { ("Hypermedia", ""), ("Low JavaScript", "tag-accent") } },
        new { Num = "09", Kind = "server", KindLabel = "Server", Name = "Blazor Server", Route = "/EmployeeBlazor",
              Text = "C# components with live updates over SignalR. One language from the database to the button.",
              Tags = new[] { ("C# components", ""), ("SignalR", "tag-info") } },
    };
}

<section class="home-hero" id="top">
    <div class="mb-container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-7">
                <span class="eyebrow">Open source · .NET 10 · Make Bold Spark</span>
                <h1>One problem.<br /><span class="accent">Nine ways</span> to build it.</h1>
                <p class="lead">
                    The same employee directory, built nine ways — from classic MVC to Blazor — inside one
                    ASP.NET Core app. See the trade-offs side by side before you commit your team to one.
                </p>
                <div class="d-flex flex-wrap gap-2 pt-3">
                    <a class="btn btn-primary btn-lg" href="#patterns">Explore the patterns</a>
                    <a class="btn btn-link btn-lg" href="/api-test-spark">Read the API docs →</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="route-panel">
                    <header>
                        <span class="eyebrow">One domain · nine routes</span>
                        <code>EmployeeDto</code>
                    </header>
                    <ul>
                        @foreach (var p in patterns)
                        {
                            <li><a href="@p.Route"><span>@p.Route</span><span>@p.Name</span></a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="value-strip" aria-label="Why this project exists">
    <div class="mb-container">
        <div class="row g-5">
            <div class="col-md-4">
                <h2>Clarity over hype</h2>
                <p>One domain, one database, one API. The only thing that changes is the front end — so the comparison is honest.</p>
            </div>
            <div class="col-md-4">
                <h2>Production habits</h2>
                <p>Dependency injection, a repository layer, health checks, tests and containers. Built the way we build for clients.</p>
            </div>
            <div class="col-md-4">
                <h2>Open to learn from</h2>
                <p>MIT licensed and maintained since 2019. Clone it, run it, and take what fits your team.</p>
            </div>
        </div>
    </div>
</section>

<section class="home-section" id="patterns">
    <div class="mb-container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-4 mb-5">
            <div style="max-width: 40rem;">
                <span class="eyebrow">The patterns</span>
                <h2 class="section-title">Pick the pattern that fits your team.</h2>
                <p class="section-lead mb-0">
                    Every demo does the same job: list, create, edit and delete employees.
                    Open two side by side and the differences speak for themselves.
                </p>
            </div>
            <div class="pattern-filter d-flex flex-wrap gap-2" role="group" aria-label="Filter patterns">
                <button type="button" class="btn btn-outline-secondary" data-filter="all" aria-pressed="true">All nine</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="server" aria-pressed="false">Server-rendered</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="hybrid" aria-pressed="false">Hybrid</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="client" aria-pressed="false">Client-side</button>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var p in patterns)
            {
                <div class="col-md-6 col-lg-4" data-kind="@p.Kind">
                    <article class="card pattern-card position-relative @(p.Num == "06" ? "is-featured" : "")">
                        <span class="kicker">@p.Num · @p.KindLabel</span>
                        <h3>@p.Name</h3>
                        <p>@p.Text</p>
                        <div class="tags">
                            @foreach (var (label, css) in p.Tags)
                            {
                                <span class="tag @css">@label</span>
                            }
                        </div>
                        <a class="stretched-link" href="@p.Route" aria-label="View the @p.Name demo">View demo →</a>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

<section class="hood home-section" id="under-the-hood">
    <div class="mb-container">
        <div class="row g-5">
            <div class="col-lg-5">
                <span class="eyebrow">Under the hood</span>
                <h2 class="section-title">Built the way we would build it for you.</h2>
                <p class="section-lead">
                    The patterns sit on one shared core. Swap the front end and nothing underneath has to change.
                </p>
                <div class="d-flex flex-wrap gap-2 pt-2">
                    <a class="btn btn-dark" href="/EmployeePivot">Open the pivot report</a>
                    <a class="btn btn-outline-primary" href="/health">Check /health</a>
                </div>
            </div>
            <div class="col-lg-7">
                <ul class="hood-list">
                    <li><strong>REST API + OpenAPI</strong><span>Versioned endpoints at <code>/api/v1/employee</code>, standard verbs, ProblemDetails errors.</span></li>
                    <li><strong>Clean architecture</strong><span>Domain, repository and web layers. DTOs, never EF entities, reach the UI.</span></li>
                    <li><strong>Pivot reporting</strong><span>Slice the same data with PivotTable.js and Plotly renderers.</span></li>
                    <li><strong>Health and telemetry</strong><span>Health checks at <code>/health</code> and Application Insights.</span></li>
                    <li><strong>Containers and CI</strong><span>Multi-stage Docker build, GitHub Actions, CodeQL and Trivy scanning.</span></li>
                    <li><strong>Light and dark themes</strong><span>Make Bold brand tokens throughout, one toggle in the header.</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="home-section" id="run-it">
    <div class="mb-container">
        <div class="row g-5">
            <div class="col-lg-5">
                <span class="eyebrow">Run it locally</span>
                <h2 class="section-title">Ten minutes from clone to comparison.</h2>
                <p class="section-lead">
                    This is a teaching project. Data lives in memory, there is no sign-in, and the sample
                    employees are generated on start-up. Add persistence, validation and security before
                    you take a pattern to production.
                </p>
                <a href="https://github.com/markhazleton/UISampleSpark/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Read the changelog →</a>
            </div>
            <div class="col-lg-7 d-flex flex-column gap-4">
                <div class="card">
                    <div class="card-header fw-semibold">With the .NET SDK</div>
                    <pre class="mb-0 p-4"><code>git clone https://github.com/markhazleton/UISampleSpark.git
cd UISampleSpark/UISampleSpark.UI
dotnet run</code></pre>
                </div>
                <div class="card">
                    <div class="card-header fw-semibold">With Docker</div>
                    <pre class="mb-0 p-4"><code>docker pull markhazleton/uisamplespark:latest
docker run -p 8080:8080 markhazleton/uisamplespark
# then open http://localhost:8080</code></pre>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="mb-container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-7">
                <span class="eyebrow">Make Bold Spark</span>
                <h2>Every team deserves a clear front-end decision.</h2>
                <p class="mb-0">Pull the image, open two patterns side by side, and decide with your own eyes.</p>
            </div>
            <div class="col-lg-5 d-flex flex-column gap-3">
                <code>docker pull markhazleton/uisamplespark</code>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-dark btn-lg" href="https://github.com/markhazleton/UISampleSpark" target="_blank" rel="noopener">Clone on GitHub</a>
                    <a class="btn btn-outline-light btn-lg" href="https://makeboldspark.com" target="_blank" rel="noopener">More from Make Bold Spark</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var buttons = document.querySelectorAll('.pattern-filter [data-filter]');
            var cards = document.querySelectorAll('#patterns [data-kind]');
            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var filter = btn.getAttribute('data-filter');
                    buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
                    cards.forEach(function (card) {
                        card.hidden = filter !== 'all' && card.getAttribute('data-kind') !== filter;
                    });
                });
            });
        })();
    </script>
}

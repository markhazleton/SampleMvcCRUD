@{
    ViewBag.Title = "jQuery AJAX + MVC employee directory — modal forms";
    ViewBag.MetaDescription = "The UISampleSpark employee directory on one MVC page: jQuery loads partial views into modals, so nothing reloads.";
    ViewBag.MetaKeywords = "ASP.NET MVC, JQuery AJAX, CRUD operations, MVC Forms, employee management, MVC tutorial, partial views, API endpoints";
}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h2 card-title text-center">jQuery AJAX + MVC employee directory</h1>
            <p class="text-muted text-center">
                Pattern 02 · One page with modal forms. jQuery asks the controller for partial views and swaps them in, so the page never reloads.
            </p>
            <p class="text-center">
                <a href="#" class="btn btn-primary" onclick="return loadEmployeeEdit('0')">Add employee</a>
                <a href="#" class="btn btn-info" onclick="return loadEmployeeList()">Reload the list</a>
            </p>
            <div id="content-employeelist"></div>
        </div>
    </div>

    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div id="modalContent" class="modal-content"></div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h3 card-title">How this pattern works</h2>
            <p class="card-text">
                <strong>Index.cshtml</strong> shows the list. Create, edit and delete each open a modal filled with a partial view the controller returns over AJAX. Saving posts back the same way, and the list refreshes without a full page load.
            </p>
            <h3 class="h4">How it's built</h3>
            <ul>
                <li><strong>Partial views:</strong> one each for create, edit and delete.</li>
                <li><strong>Controller actions:</strong> answer each AJAX request with a partial view or JSON.</li>
                <li><strong>jQuery functions:</strong> open the modals, post the form and refresh the list.</li>
            </ul>
            <h3 class="h4">Good for</h3>
            <ul>
                <li><strong>Upgrading an existing MVC app:</strong> you keep your controllers and views.</li>
                <li><strong>One screen:</strong> every action starts from the list, with no navigation.</li>
                <li><strong>Lighter requests:</strong> only the fragment that changed travels.</li>
            </ul>
            <h3 class="h4">Watch for</h3>
            <ul>
                <li><strong>Logic in two places:</strong> you need to be at home in jQuery, AJAX and MVC.</li>
                <li><strong>Harder debugging:</strong> asynchronous calls and partial views add moving parts.</li>
                <li><strong>Search visibility:</strong> content loaded by script is harder for search engines to see.</li>
            </ul>
        </div>
    </div>
</div>






@section scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            loadEmployeeList();
        });

        //Load Employee List
        function loadEmployeeList() {
            $('#myModal').modal('hide');
            $.ajax({
                url: '/Employee/GetEmployeeList',
                type: 'get',
                dataType: 'html',
                success: function (data) {
                    $("#content-employeelist").html(data);
                    $("#content-employeelist").fadeIn();
                },
                error: function (errormessage) { alert(errormessage.responseText); }
            })
        };

        //Load Employee Edit
        function loadEmployeeEdit(EmpID) {
            $.ajax({
                url: '/Employee/GetEmployeeEdit/' + EmpID,
                type: 'get',
                dataType: 'html',
                success: function (data) {
                    $("#modalContent").html(data);
                    $('#myModal').modal('show');
                    $('#btnUpdate').show();
                    $('#btnAdd').hide();
                },
                error: function (errormessage) { alert(errormessage.responseText); }
            })
        };

        //Load Employee Delete
        function loadEmployeeDelete(EmpID) {
            $.ajax({
                url: '/Employee/GetEmployeeDelete/' + EmpID,
                type: 'get',
                dataType: 'html',
                success: function (data) {
                    $("#modalContent").html(data);
                    $('#myModal').modal('show');
                    $('#btnUpdate').show();
                    $('#btnAdd').hide();
                },
                error: function (errormessage) { alert(errormessage.responseText); }
            })
        };

        function SaveEmployee(id) {
            var empId = +$('#id').val();
            var depId = +$('#Department').val();
            var genderId = +$('#Gender').val();
            var ageId = +$('#Age').val();

            var employee = {
                id: empId,
                name: $('#Name').val(),
                gender: genderId,
                age: ageId,
                state: $('#State').val(),
                country: $('#Country').val(),
                department: depId
            };

            var jsonEmpObj = JSON.stringify(employee)

            if (id === 0)
            {
                AddEmployee(jsonEmpObj);
            }
            else
            {
                UpdateEmployee(id, jsonEmpObj);
            }
        }

        function AddEmployee(jsonEmpObj) {
            $.ajax({
                url: '/Employee/',
                data: jsonEmpObj,
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    loadEmployeeList();
                    $('#myModal').modal('hide');
                },
                error: function (errormessage) { 
                    alert(errormessage.responseText); 
                    loadEmployeeList();
                    $('#myModal').modal('hide');
                }
            });
        }

        function UpdateEmployee(id, jsonEmpObj) {
            $.ajax({
                url: '/Employee/' + id,
                data: jsonEmpObj,
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    loadEmployeeList();
                    $('#myModal').modal('hide');
                },
                error: function (errormessage) { 
                    alert(errormessage.responseText); 
                    loadEmployeeList();
                    $('#myModal').modal('hide');
                },
            });
        }

        function DeleteEmployee(id) {
            $.ajax({
                url: '/Employee/' + id,
                type: 'delete',
                dataType: 'html',
                success: function (data) {
                    loadEmployeeList();
                },
                error: function (errormessage) { alert(errormessage.responseText); }
            });
        }
    </script>
}
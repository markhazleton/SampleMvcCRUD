@model UISampleSpark.Core.Models.EmployeeDto

@{
    ViewBag.Title = $"Delete {Model.Name}? — Traditional MVC";
    ViewBag.MetaDescription = $"Confirm before deleting {Model.Name}: a classic MVC pattern with one action to show and one to act.";
    ViewBag.MetaKeywords = "ASP.NET MVC, Employee Delete, UI patterns tutorial, MVC Forms, employee management, form handling, model binding";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h2 card-title text-center text-danger">Delete @Model.Name?</h1>
            <p class="lead text-center text-muted">This removes them from the directory. You can't undo it.</p>
            <div class="mt-4">
                <dl class="row">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Gender)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Gender)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Age)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Age)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.State)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.State)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Country)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Country)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Department)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Department)</dd>
                </dl>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <div class="d-flex justify-content-center mt-4">
                    <input type="submit" value="Delete employee" class="btn btn-danger me-3" />
                    @Html.ActionLink("Back to the directory", "Index", null, htmlAttributes: new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h3 card-title">How this page works</h2>
            <p class="card-text">
                Deleting takes two steps on purpose. This page shows the record so you can check it, and only the form post, protected by an anti-forgery token, removes it.
            </p>
            <p class="card-text">
                That confirm-then-post shape is plain MVC: one GET action to show, one POST action to act.
            </p>
        </div>
    </div>
</div>

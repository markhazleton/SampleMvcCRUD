@model IEnumerable<UISampleSpark.Core.Models.EmployeeDto>
@{
    ViewBag.Title = "Traditional MVC employee directory — controllers and views";
    ViewBag.MetaDescription = "The UISampleSpark employee directory as classic ASP.NET Core MVC: one controller action and view per job, with full form posts.";
    ViewBag.MetaKeywords = "ASP.NET MVC, MVC Forms, employee management, CRUD operations, ASP.NET tutorial, MVC best practices, Microsoft support";
}

<div class="container">

    <h1 class="h2">Traditional MVC employee directory</h1>
    <p class="text-muted">Pattern 01 · Classic controllers and views. Each job gets its own page, and every save is a full form post.</p>

    <p>
        @Html.ActionLink("Add employee", "Create", null, htmlAttributes: new { @class = "btn btn-primary" })
    </p>
    <table id="DataTable" class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                     @Html.DisplayNameFor(model => model.Gender)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Age)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.State)
                </th>
                <th>
                    Department
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/images/@item.ProfilePicture"
                         class="rounded-circle"
                         height="40" width="40"
                         asp-append-version="true" />
                            @Html.ActionLink(item.Name, "Edit", new { id = item.Id }, htmlAttributes: new { @class = "" })

                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Gender)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Age)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.State)
                        </td>
                        <td>
                            @item.Department.ToString()
                        </td>
                        <td>
                            <a href="/MvcEmployee/Edit/@item.Id" title="Edit Employee" aria-label="Edit employee">
                                <i class="icon icon-pencil" aria-hidden="true"></i>
                            </a>

                            <a href="/MvcEmployee/Delete/@item.Id" title="Delete Employee" aria-label="Delete employee">
                                <i class="icon icon-trash-2" aria-hidden="true"></i>
                            </a>


                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot></tfoot>
    </table>
</div>

<div class="container mt-4">
    <h2 class="h3">How this pattern works</h2>
    <p>
        List, create, edit, details and delete are each a controller action with its own view. Forms post back to the server, which saves and redirects. It's the most predictable pattern here, and the easiest for search engines to read.
    </p>
    <h3 class="h4">Good habits</h3>
    <ul>
        <li>Use <code>[HttpGet]</code> and <code>[HttpPost]</code> to keep reads and writes apart.</li>
        <li>Validate with data annotations, and check <code>ModelState</code> on every post.</li>
        <li>Add <code>@Html.AntiForgeryToken()</code> to every form to block cross-site request forgery.</li>
    </ul>
    <h3 class="h4">Trade-offs</h3>
    <ul>
        <li><strong>Good for:</strong> clear separation of concerns, easy testing, strong model binding and validation.</li>
        <li><strong>Watch for:</strong> large forms get unwieldy, and every action costs a full page load.</li>
    </ul>
    <p>
        Microsoft still invests in MVC, and on .NET 10 it remains a dependable choice for clean, maintainable web apps.
    </p>
</div>
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h3 card-title">One action per job</h2>
            <p class="card-text">
                <strong>Create</strong> shows a form and saves the new employee when you submit it. <strong>Read</strong> lists employees, as in the table above. <strong>Update</strong> edits one employee, and <strong>Delete</strong> asks you to confirm first.
            </p>
            <p class="card-text">
                Scaffolding can generate these views straight from your Entity Framework entities. It's a fast start, but pass view models to your views rather than entities, so the database shape never leaks into the UI.
            </p>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DataTable').DataTable();
        });
    </script>
}

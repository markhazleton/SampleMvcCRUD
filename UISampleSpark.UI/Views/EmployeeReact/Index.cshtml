                    {/* Modals */}
                    <EmployeeFormModal
                        show={showForm}
                        employee={editEmployee}
                        departments={departments}
                        onSave={handleSave}
                        onClose={() => { setShowForm(false); setEditEmployee(null); }}
                    />
                    <DeleteModal

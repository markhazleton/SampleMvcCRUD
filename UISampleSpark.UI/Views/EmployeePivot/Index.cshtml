@{
    Layout = "_LayoutPivot";
    ViewBag.Title = "Pivot report — explore employee data with PivotTable.js";
    ViewBag.MetaDescription = "Slice the UISampleSpark employee data any way you like with an interactive PivotTable.js report and Plotly charts.";
    ViewBag.MetaKeywords = "PivotTables.js, ASP.NET MVC, data visualization, employee data analysis, JavaScript pivot tables, data analytics, interactive tables";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h2 card-title text-center">Pivot report</h1>
            <p class="card-text">
                Slice the same employee data any way you like. Drag fields into rows and columns, pick a summary, and switch to a chart.
            </p>
        </div>
    </div>

    <div id="content-employeelist" class="mt-4">
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h3 card-title">How this report works</h2>
            <p class="card-text">
                PivotTable.js turns a JSON array into an interactive pivot table in the browser. Nicolas Kruchten created it, and it has stayed popular because it's simple to embed and easy to customize. Plotly renderers add the charts.
            </p>
            <h3 class="h4 card-subtitle mt-3">Good for</h3>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item"><strong>Self-serve analysis:</strong> pivot, filter and summarize without writing a query.</li>
                <li class="list-group-item"><strong>Customization:</strong> renderers, aggregators and options cover most reporting needs.</li>
                <li class="list-group-item"><strong>Open source:</strong> MIT licensed, with a long track record.</li>
            </ul>
            <h3 class="h4 card-subtitle mt-3">Watch for</h3>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Large datasets:</strong> everything runs in the browser, so very big tables slow down.</li>
                <li class="list-group-item"><strong>Custom work takes JavaScript:</strong> going past the defaults means writing code.</li>
            </ul>
            <p class="card-text mt-3">
                For quick, flexible exploration of modest datasets, it's hard to beat.
            </p>
        </div>
    </div>
</div>



@section scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            loadEmployeeList();
        });

        //Load Employee List
        function loadEmployeeList() {
            $.ajax({
                url: '/EmployeePivot/GetEmployeeList',
                type: 'get',
                dataType: 'html',
                success: function (data) {
                    $("#content-employeelist").html(data);
                    $("#content-employeelist").fadeIn();
                },
                error: function (errormessage) { alert(errormessage.responseText); }
            })
        };
    </script>
}
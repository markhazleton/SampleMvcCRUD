<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    @await Html.PartialAsync("_SiteHead")
    <link rel="dns-prefetch" href="https://code.jquery.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pivottable@@2.23.0/dist/pivot.min.css" />
    <link rel="stylesheet" href="~/css/makebold.css" asp-append-version="true" />
    @RenderSection("HeadScripts", required: false)
</head>

<body id="page-top" class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-primary btn-sm" style="z-index:2000" href="#main">Skip to content</a>
    @await Html.PartialAsync("_SiteHeader")

    <main role="main" id="main" class="site-main @(ViewData["FlushMain"] is true ? "" : "py-4")">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        @await Html.PartialAsync("_Footer")
    </footer>

        <!-- JavaScript Bundle -->
    <!-- jQuery 3.7.1 from CDN (stable, widely supported) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <!-- jQuery UI and Touch Punch (integrity removed due to CDN hash mismatches) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui-touch-punch/0.2.3/jquery.ui.touch-punch.min.js" crossorigin="anonymous"></script>
    <!-- PivotTable.js via jsDelivr (stable, jQuery 3.7.1 compatible) -->
    <script src="https://cdn.jsdelivr.net/npm/pivottable@@2.23.0/dist/pivot.min.js"></script>
    <!-- Plotly.js for advanced chart renderers (optional but recommended) -->
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js" charset="utf-8"></script>
    <script src="https://cdn.jsdelivr.net/npm/pivottable@@2.23.0/dist/plotly_renderers.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

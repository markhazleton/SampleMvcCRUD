@{
    Layout = "~/Views/Shared/_LayoutHtmx.cshtml";
    ViewBag.Title = "htmx employee directory — HTML over the wire";
    ViewBag.MetaDescription = "The UISampleSpark employee directory built with htmx: the server returns HTML fragments and htmx swaps them into the page.";
    ViewBag.MetaKeywords = "htmx, hypermedia, HTML over the wire, server-driven, CRUD operations, ASP.NET Core, HATEOAS";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h2 mb-0">
                        <i class="icon icon-refresh-cw text-primary me-2" aria-hidden="true"></i>htmx employee directory
                    </h1>
                    <p class="text-muted">Pattern 08 · HTML over the wire, with almost no JavaScript.</p>
                </div>
                <button type="button" class="btn btn-primary"
                        hx-get="/EmployeeHtmx/Edit"
                        hx-target="#form-container"
                        hx-swap="innerHTML">
                    <i class="icon icon-circle-plus me-2" aria-hidden="true"></i>Add employee
                </button>
            </div>

            <div class="card shadow-sm rounded-3 border-0">
                <!-- Search and Page Size Controls -->
                <div class="card-body border-bottom">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <label class="me-2 text-nowrap"><i class="icon icon-list" aria-hidden="true"></i> Show</label>
                                <select class="form-select form-select-sm" style="width: auto" id="pageSize"
                                        hx-get="/EmployeeHtmx/Table"
                                        hx-target="#employee-table"
                                        hx-include="#searchInput"
                                        hx-swap="innerHTML"
                                        name="pageSize">
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="ms-2 text-muted small">per page</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="icon icon-search" aria-hidden="true"></i></span>
                                <input type="text" class="form-control" id="searchInput" name="search"
                                       placeholder="Search the directory"
                                       hx-get="/EmployeeHtmx/Table"
                                       hx-trigger="keyup changed delay:500ms"
                                       hx-target="#employee-table"
                                       hx-include="#pageSize"
                                       hx-swap="innerHTML" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Employee Table -->
                <div id="employee-table"
                     hx-get="/EmployeeHtmx/Table"
                     hx-trigger="load, refreshTable from:body"
                     hx-include="#searchInput, #pageSize"
                     hx-swap="innerHTML">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-2">Loading the directory…</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for forms -->
    <div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="form-container">
            </div>
        </div>
    </div>

    <!-- Documentation Section -->
    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card shadow-sm rounded-3 border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="icon icon-info me-2" aria-hidden="true"></i>How this pattern works</h3>
                </div>
                <div class="card-body p-4">
                    <p class="lead">
                        The server stays in charge. Instead of JSON, it returns HTML fragments, and htmx swaps them into the page.
                    </p>

                    <div class="row g-4 mt-2">
                        <div class="col-md-6">
                            <div class="card h-100 bg-light border-0">
                                <div class="card-body">
                                    <h4 class="card-title"><i class="icon icon-sparkles text-warning me-2" aria-hidden="true"></i>Good for</h4>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-check text-success me-2" aria-hidden="true"></i>Server-first teams who want a single-page feel</li>
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-check text-success me-2" aria-hidden="true"></i>Search engines, because the HTML is real</li>
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-check text-success me-2" aria-hidden="true"></i>A small library, about 14 KB gzipped</li>
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-check text-success me-2" aria-hidden="true"></i>Reusing the Razor views you already have</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 bg-light border-0">
                                <div class="card-body">
                                    <h4 class="card-title"><i class="icon icon-triangle-alert text-warning me-2" aria-hidden="true"></i>Watch for</h4>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-minus text-danger me-2" aria-hidden="true"></i>Every interaction is a trip to the server</li>
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-minus text-danger me-2" aria-hidden="true"></i>Complex state that lives in the browser</li>
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-minus text-danger me-2" aria-hidden="true"></i>Offline or highly interactive apps</li>
                                        <li class="list-group-item bg-transparent border-0"><i class="icon icon-circle-minus text-danger me-2" aria-hidden="true"></i>A growing pile of partial views to manage</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h4><i class="icon icon-code me-2" aria-hidden="true"></i>How it's built</h4>
                        <div class="row g-3 mt-1">
                            <div class="col-md-3">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body">
                                        <h6 class="fw-bold"><i class="icon icon-box me-1" aria-hidden="true"></i> htmx 2.0</h6>
                                        <p class="small text-muted mb-0">Loaded from a CDN. <code>hx-get</code>, <code>hx-post</code> and <code>hx-delete</code> attributes replace hand-written AJAX.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body">
                                        <h6 class="fw-bold"><i class="icon icon-arrow-left-right me-1" aria-hidden="true"></i> HTML fragments</h6>
                                        <p class="small text-muted mb-0">The server returns partial views, and <code>hx-target</code> and <code>hx-swap</code> decide where they land.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body">
                                        <h6 class="fw-bold"><i class="icon icon-radio me-1" aria-hidden="true"></i> Event triggers</h6>
                                        <p class="small text-muted mb-0"><code>HX-Trigger</code> response headers refresh the table after every create, update and delete.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body">
                                        <h6 class="fw-bold"><i class="icon icon-file me-1" aria-hidden="true"></i> Server paging</h6>
                                        <p class="small text-muted mb-0">Paging and filtering happen on the server, with live search after a 500 ms pause.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="icon icon-wrench me-2" aria-hidden="true"></i>Built by Mark Hazleton for Make Bold Spark</span>
                        <a href="https://github.com/markhazleton/UISampleSpark" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener noreferrer">
                            <i class="icon icon-git-fork me-2" aria-hidden="true"></i>Read the source
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show modal when form content is loaded
        document.body.addEventListener('htmx:afterSwap', function (event) {
            if (event.detail.target.id === 'form-container') {
                var modal = new bootstrap.Modal(document.getElementById('employeeModal'));
                modal.show();
            }
        });

        // Hide modal after successful save/delete
        document.body.addEventListener('refreshTable', function () {
            var modalEl = document.getElementById('employeeModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        });
    </script>
}

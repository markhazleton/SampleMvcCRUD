@model EmployeeDto

<div class="modal-header bg-danger text-white">
    <h5 class="modal-title">
        <i class="icon icon-triangle-alert me-2" aria-hidden="true"></i>Delete employee
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Delete <strong>@Model?.Name</strong> from the directory?</p>
    <p class="text-muted mb-0">You can't undo this.</p>
</div>
<div class="modal-footer bg-light">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="icon icon-circle-x me-1" aria-hidden="true"></i> Cancel
    </button>
    <button type="button" class="btn btn-danger"
            hx-delete="/EmployeeHtmx/Delete/@Model?.Id"
            hx-swap="none">
        <i class="icon icon-trash-2 me-1" aria-hidden="true"></i> Delete
    </button>
</div>
